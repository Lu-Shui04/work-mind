# WorkMind 环境变量模板
# ─────────────────────────────────────────────────────────────
# 【密钥只有这一份】复制成**仓库根目录**的 .env 后填写真实值：
#     cp .env.example .env
# .env 已被 .gitignore 忽略，永远不会被提交；
# docker-compose 和直接跑 uvicorn 都从它读取，不要再在别的地方写 key。

# ── 必填：对话模型（DeepSeek，兼容 OpenAI 协议）────────────────
DEEPSEEK_API_KEY=
PRIMARY_MODEL=deepseek-chat

# ── 可选：RAG Embedding（智谱 embedding-3，2048 维）──────────────
# 优先于下面的 OPENAI_API_KEY；申请：https://open.bigmodel.cn
ZHIPU_API_KEY=

# ── 可选：OpenAI 兼容的 Embedding 备选（SiliconFlow 等）──────────
OPENAI_API_KEY=
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3

# ── 服务 ───────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=http://localhost:5173

# ── 知识库数据库（PostgreSQL + pgvector，见 docker-compose 的 db 服务）──
# 宿主机端口用 5433，避免和本机已有的 PostgreSQL 冲突
# 下面是本地开发的默认值（只在容器网络内/本机 5433 使用），部署到公网前必须改
PG_USER=workmind
PG_PASSWORD=workmind
PG_DATABASE=workmind
PG_PORT=5433
# 直接连库（不填则由 compose 注入 postgresql://<PG_USER>:<PG_PASSWORD>@db:5432/<PG_DATABASE>）
# DATABASE_URL=postgresql://workmind:workmind@localhost:5433/workmind
# 向量维度：必须与 embedding 模型一致（智谱 embedding-3 = 2048）
PGVECTOR_DIM=2048
# 向量索引：none=精确检索（默认，2048 维超过 pgvector HNSW 的 2000 维上限）
PGVECTOR_INDEX=none
PG_POOL_MIN=1
PG_POOL_MAX=10

# ── 意图识别：要不要查知识库 ────────────────────────────────────
# recall_first（默认）默认就查，只有打招呼/闲聊/纯算式才跳过
# strict        旧的严格模式（命中关键词或疑问句才查）
RAG_INTENT_MODE=recall_first
RAG_INTENT_LLM_FALLBACK=true

# ── 检索 ───────────────────────────────────────────────────────
# 相似度阈值：必须按 embedding 模型标定。
# 智谱 embedding-3 实测：同段文字近似重复 ≈0.57，语义相关换说法 ≈0.42，无关 ≤0.33
RAG_SIMILARITY_THRESHOLD=0.35
# 相对阈值：只保留 ≥(最高分 - MARGIN) 的切片，0=关闭
RAG_SIMILARITY_MARGIN=0
# 喂给模型的参考切片条数
RAG_TOP_K=6
# 「自动」模式下检索不到内容时怎么回答：
#   fallback（默认）= 先明确说明"知识库未命中"，然后照常用通用知识回答
#   grounded        = 只回"没找到"，不拿模型自身知识兜底（想更保守就改成这个）
# 注意：「强制检索」不看这个开关 —— 强制就是只依据知识库作答，查不到就说查不到；
#       「关闭检索」压根不查库，直接回答。
RAG_ANSWER_POLICY=fallback

# ── 会话记忆（对话与 Agent 共用一套机制）────────────────────────
# 超过 N 轮 → 用大模型**异步**把更早的对话压缩成摘要（不阻塞当前回答）；
# 每次请求只带「摘要 + 最近 K 轮原文」，既有长期记忆又不会越聊越贵。
MEMORY_SUMMARY_AFTER_ROUNDS=10
MEMORY_KEEP_ROUNDS=10
# 最近原文再长也不超过这么多 token（极端长回复的兜底）
MEMORY_RECENT_MAX_TOKENS=4000

# ── 切块（改完必须重新入库才对已入库文档生效）────────────────────
# 目标长度 / 硬上限 / 重叠（按句对齐）/ 小于此长度并入相邻片
RAG_CHUNK_TARGET=500
RAG_CHUNK_MAX=1200
RAG_CHUNK_OVERLAP=80
RAG_CHUNK_MIN=150

# ── 重排 Rerank（宽召回 → 精排 → 取前 k）─────────────────────────
# llm = 用 DEEPSEEK_API_KEY 做 listwise 打分（默认：零额外依赖，立即可用）
# bge = Cohere/Jina 兼容的专用 rerank 接口（推荐生产：BAAI/bge-reranker-v2-m3）
# none = 关闭
# 注意：智谱的 rerank 接口实测没有判别力（10 条候选全返回 1.0000），不要用它
RERANK_PROVIDER=llm
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
# 费用看板的单价（元 / 百万 tokens）：DeepSeek 的单价内置在
# server-py/app/services/pricing.py（官方价目，按 模型 × 缓存命中 × 峰谷 自动算），不用在这里配。
# 这里只配**第三方**接口的单价 —— 没有可引用公开单价的一律按 0 计，看板上会标"未计价"，
# 绝不编一个数字。bge 重排按你账号的实际价格填，例如 0.1。
PRICE_RERANK_PER_M=
# 召回池 = k × POOL_MULT（上限 POOL_MAX）；候选条数与单条字符数决定 LLM 重排的开销
RERANK_POOL_MULT=3
RERANK_POOL_MAX=20
RERANK_MAX_CANDIDATES=12
RERANK_MAX_CHARS=600
# 重排分数下限：低于它的候选直接丢弃（不是排后面，是不要），0 = 关闭过滤
# 不填则按 provider 取默认：bge=0.3（0~1 标度）/ llm=5（0~10 标度）
# 为什么需要：向量阈值只能保证"主题沾边"，噪音切片留在结果里会让 Agent 误判成"知识库有答案"，
# 从而把整次任务锁死在知识分支（回一句"未找到"，联网搜索/生成报告等工具完全没机会执行）。
RAG_RERANK_MIN_SCORE=

# ── 缓存 ───────────────────────────────────────────────────────
CACHE_TTL=1800000

# ── 联网搜索（Agent 的 web_search 工具）─────────────────────────
# 不配 key = demo 模式：只返回内置演示数据，并明确告诉模型「未接入真实联网搜索」。
# 配了任一个 key 就是真实搜索，优先级：TAVILY > BOCHA > ZHIPU。
#   zhipu  —— 智谱 Web Search，**直接复用知识库那个 ZHIPU_API_KEY**，
#             国内部署通常不用再申请服务，配好上面的 key 就能搜（推荐）
#   tavily —— https://tavily.com ，国际通用，注册即有免费额度
#   bocha  —— https://open.bochaai.com ，国内可直连的中文搜索
# 也可以用 SEARCH_PROVIDER 强制指定：tavily / bocha / zhipu / demo
# 自检： bash scripts/check-web-search.sh
TAVILY_API_KEY=
BOCHA_API_KEY=
SEARCH_PROVIDER=auto
SEARCH_MAX_RESULTS=5
# 智谱搜索档位：search_std（标准版，便宜）/ search_pro（高级版，更准也更贵）
ZHIPU_SEARCH_ENGINE=search_std

# ── Agent 循环 ─────────────────────────────────────────────────
# 工具循环的最大步数（一步 = 一次模型调用，模型可在一步里并行调多个工具）。
# 默认 14 是实测标定的：10 次真实任务的模型步数分布为
#   知识库问答 0 步 / 单工具任务 3~4 步 / 搜索+报告 5~6 步 / 查不到答案 9~10 步
#   （中位数 5，最大 10），取最大值 +40% 余量，既能拦住失控循环，
#   又不会裁掉任何能自然收敛的任务。
# 用尽时不会直接结束，而是强制走收尾分支用「不带工具的模型」交一份总结。
AGENT_MAX_STEPS=14

# ── 时区 ───────────────────────────────────────────────────────
# 容器默认是 UTC，「今天是几号」会比北京时间差一天（北京时间 00:00-08:00 时），
# 请假天数、工期、倒计时这类计算会整体错一天。日期工具按这个时区算。
APP_TIMEZONE=Asia/Shanghai
